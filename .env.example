# HealthBridge AI — local development configuration.
# Copy to `.env` and replace every CHANGE_ME value. Never commit `.env`.
# All values below are placeholders for a local, synthetic-data demonstration.

# --- PostgreSQL ---
POSTGRES_USER=healthbridge
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=healthbridge

# --- Backend ---
HB_ENVIRONMENT=development
# Fernet key for encrypting stored documents at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HB_STORAGE_ENCRYPTION_KEY=CHANGE_ME_fernet_key
# Key used to HMAC-chain audit records (any long random string).
HB_AUDIT_HMAC_KEY=CHANGE_ME_long_random_string
# Set true only when served over HTTPS.
HB_COOKIE_SECURE=false
HB_DEMO_MODE=true

# --- LiveKit (self-hosted) ---
# Secret must be at least 32 characters.
LIVEKIT_API_KEY=CHANGE_ME_livekit_key
LIVEKIT_API_SECRET=CHANGE_ME_livekit_secret_at_least_32_chars
# URL the *browser* uses to reach LiveKit.
HB_LIVEKIT_PUBLIC_URL=ws://localhost:7880
# IP LiveKit advertises in ICE candidates. 127.0.0.1 = same-machine browsers only.
# Use this machine's LAN IP to test from other devices on the local network.
LIVEKIT_NODE_IP=127.0.0.1

# --- AI ---
# mock = deterministic mode (default, no model). ollama = optional local LLM.
HB_AI_MODE=mock
HB_OLLAMA_URL=http://ollama:11434
HB_OLLAMA_MODEL=llama3.2:3b
# hash = deterministic local hashing embedder (default). fastembed = local ONNX model.
HB_EMBEDDING_PROVIDER=hash
